#!/usr/bin/env bash
set -eo pipefail

# Mirrors kolobar's runner. SubParsley previously had none at all, so its tests
# only ran if you remembered the exact `python3 -m unittest` incantation — which
# is a large part of why 300 lines generating an entire CLI had 7 tests.

TEST_DIR="${1:-.}"
TEST_PATTERN="${2:-*_test*.py}"

if [ -n "$VIRTUAL_ENV" ]; then
    PYTHON_BIN="$VIRTUAL_ENV/bin/python"
elif [ -f "venv/bin/python" ]; then
    PYTHON_BIN="venv/bin/python"
elif [ -f ".venv/bin/python" ]; then
    PYTHON_BIN=".venv/bin/python"
else
    PYTHON_BIN="python3"
fi

echo "======================================================================"
echo "Python Executable : $($PYTHON_BIN --version)"
echo "Test Directory    : $TEST_DIR"
echo "File Pattern      : $TEST_PATTERN"
echo "======================================================================"

COVERAGE_OMIT="*_test*.py,tests.py"

if $PYTHON_BIN -c "import coverage" >/dev/null 2>&1; then
  # --source=. keeps the throwaway module trees the loader tests build under
  # /tmp out of the report; without it coverage aborts with "No source for code".
  $PYTHON_BIN -m coverage run --branch --source=. --omit "$COVERAGE_OMIT" -m unittest discover -s "$TEST_DIR" -p "$TEST_PATTERN" -v
  $PYTHON_BIN -m coverage report -m --omit "$COVERAGE_OMIT"
else
  $PYTHON_BIN -m unittest discover -s "$TEST_DIR" -p "$TEST_PATTERN" -v
fi
